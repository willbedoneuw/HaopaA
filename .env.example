# ============================================================================
# Target Scraper — configuration. Copy to ".env" and fill in your values.
# ============================================================================

# --- Telegram API (https://my.telegram.org) — same pair for panel + userbots ---
API_ID=1234567
API_HASH=your_api_hash_here

# --- Panel bot (from @BotFather) ---
BOT_TOKEN=123456:your_bot_token_here

# --- Who controls the panel (your numeric Telegram user id) ---
OWNER_ID=123456789

# --- Log group (numeric id, usually negative for supergroups, e.g. -1001234567890) ---
LOG_GROUP_ID=-1001234567890

# --- Encryption key for stored sessions. Any long random string.
#     If left empty, a key is derived from BOT_TOKEN (still encrypted, but
#     set a dedicated one for production). ---
ENCRYPTION_KEY=

# --- Join throttle (safe defaults; can also be changed from the panel) ---
JOIN_DELAY_START=90
JOIN_DELAY_FLOOR=60
JOIN_DELAY_CEIL=600
JOIN_DAILY_CAP=30
